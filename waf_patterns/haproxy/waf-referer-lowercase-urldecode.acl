# CRS 932206 (rce)
^[^\.]*?(?:['\*\?\x5c`][^\n/]+/|/[^/]+?['\*\?\x5c`]|\$[!#\$\(\*\-0-9\?-\[_a-\{])
# CRS 932207 (rce)
\#.*
